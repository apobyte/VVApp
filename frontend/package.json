{
  "name": "vvapp-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Static frontend server for VVApp (port 8001)",
  "main": "frontend-server.js",
  "bin": "frontend-server.js",
  "scripts": {
    "start": "node frontend-server.js",
    "build:exe": "pkg . --targets node18-win-x64 --output ../dist/vvapp-frontend-win.exe"
  },
  "pkg": {
    "assets": [
      "site/**/*"
    ],
    "outputPath": "../dist"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
